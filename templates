<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RDW Kenteken Checker</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen">

    <div class="max-w-4xl mx-auto py-12 px-4">
        <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
            
            <div class="bg-blue-600 p-6">
                <h1 class="text-2xl font-bold text-white flex items-center gap-2">
                    🚗 RDW Kenteken Scanner
                </h1>
                <p class="text-blue-100 text-sm mt-1">Upload een CSV-bestand met kentekens in de eerste kolom.</p>
            </div>

            <div class="p-8">
                <form method="POST" enctype="multipart/form-data" class="mb-10 p-6 border-2 border-dashed border-gray-200 rounded-xl bg-gray-50 flex flex-col items-center">
                    <input type="file" name="file" accept=".csv" required 
                           class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
                    <button type="submit" class="mt-4 bg-blue-600 text-white px-8 py-2 rounded-lg font-medium hover:bg-blue-700 transition shadow-md">
                        Verwerk Bestand
                    </button>
                </form>

                {% if results %}
                <div class="overflow-x-auto">
                    <h2 class="text-lg font-semibold mb-4 text-gray-700">Gevonden Resultaten:</h2>
                    <table class="w-full text-left border-collapse rounded-lg overflow-hidden shadow-sm border border-gray-100">
                        <thead class="bg-gray-100 text-gray-600 uppercase text-xs font-bold">
                            <tr>
                                <th class="p-4 border-b">Kenteken</th>
                                <th class="p-4 border-b">1e Toelating NL</th>
                                <th class="p-4 border-b">Laatste Tenaamstelling</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for row in results %}
                            <tr class="hover:bg-blue-50 transition">
                                <td class="p-4">
                                    <span class="bg-yellow-400 text-black px-2 py-1 rounded font-mono font-bold border border-black text-sm uppercase shadow-sm">
                                        {{ row.kenteken }}
                                    </span>
                                </td>
                                <td class="p-4 text-gray-600 font-medium italic">
                                    {{ row.eerste_nl }}
                                </td>
                                <td class="p-4 text-gray-600 font-medium italic">
                                    {{ row.laatste }}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>

            <div class="bg-gray-50 p-4 border-t border-gray-100 text-center">
                <p class="text-gray-400 text-xs italic">Data geleverd door RDW Open Data API</p>
            </div>
        </div>
    </div>

</body>
</html>
